# ==============================================================================
# AlgoFight Production Environment Configuration (MITS Server)
# Copy this file to .env on the server and populate strong, unique credentials.
# ==============================================================================

# Database Credentials (Required by docker-compose)
POSTGRES_PASSWORD=your_strong_postgres_password_here

# Security Secrets (Required: Min 32 characters recommended)
ADMIN_SECRET_KEY=your_secure_admin_secret_key_here
GATEWAY_CLUSTER_SECRET=your_secure_gateway_cluster_secret_here

# Web & CORS Configuration
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Piston Code Execution Cluster (Defaults to internal container DNS)
PISTON_URL=http://piston-1:2000
PISTON_BACKUP_URLS=http://piston-2:2000
ENABLE_DYNAMIC_AUTOSCALING=false