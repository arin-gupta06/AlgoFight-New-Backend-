{
  "name": "AlgoFight-backend-new",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "packageManager": "pnpm@11.4.0",
  "main": "index.js",
  "scripts": {
    "dev": "turbo dev",
    "dev:api": "pnpm --filter @algofight/api exec tsx watch src/index.ts",
    "dev:worker": "pnpm --filter @algofight/worker exec tsx watch src/index.ts",
    "build:api": "pnpm --filter @algofight/database exec prisma db push --accept-data-loss && pnpm --filter @algofight/database exec prisma generate && pnpm --filter @algofight/api run build",
    "import:problems": "pnpm exec tsx scripts/database/import-problems.ts",
    "start:api": "pnpm --filter @algofight/api exec tsx src/index.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.3",
    "prisma": "^7.8.0",
    "tsx": "^4.22.3",
    "turbo": "^2.9.15",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "dotenv": "^17.4.2"
  }
}
